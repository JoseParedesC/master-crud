{
  "name": "@joseparedesc/master-crud",
  "version": "0.2.0",
  "description": "Componente de administración de maestros (tabla + formulario + CRUD) 100% desacoplado del backend. Trae un adaptador REST genérico y, opcionalmente, uno para Firestore.",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "sideEffects": false,
  "files": ["dist"],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./firestore": {
      "types": "./dist/firestore.d.ts",
      "import": "./dist/firestore.js",
      "require": "./dist/firestore.cjs"
    },
    "./styles.css": "./dist/styles.css"
  },
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch"
  },
  "peerDependencies": {
    "react": ">=18",
    "firebase": ">=10"
  },
  "peerDependenciesMeta": {
    "firebase": {
      "optional": true
    }
  },
  "dependencies": {
    "lucide-react": "^0.383.0",
    "react-hook-form": "^7.52.0",
    "@hookform/resolvers": "^3.6.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/react": "^18.3.3",
    "firebase": "^12.18.0",
    "react": "^18.3.1",
    "tsup": "^8.2.4",
    "typescript": "^5.5.3"
  }
}
