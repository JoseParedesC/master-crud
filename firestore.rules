rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwnerField(field) {
      return request.resource.data[field] == request.auth.uid;
    }

    function unchanged(field) {
      return request.resource.data[field] == resource.data[field];
    }

    // ── Registro de unicidad de código ──────────────────────────────
    // El ID del documento es "{collection}__{code-en-minusculas}".
    // Al crear, solo se permite si NO existe ya (compare-and-swap real,
    // reforzado del lado del servidor, no solo en el cliente).
    match /masterCodeRegistry/{registryId} {
      allow read: if isSignedIn();

      allow create: if isSignedIn()
                    && !exists(/databases/$(database)/documents/masterCodeRegistry/$(registryId));

      // Solo se permite borrar/actualizar el registro si el usuario tiene
      // permiso de escritura sobre la colección referenciada (ver reglas
      // de cada maestro más abajo). Aquí se deja abierto a usuarios
      // autenticados porque la operación real siempre ocurre junto con la
      // escritura del documento maestro en una transacción del cliente;
      // el endurecimiento final (impedir que cualquiera libere el código
      // de otro) debería moverse a una Cloud Function si se requiere
      // garantía dura.
      allow update, delete: if isSignedIn();
    }

    // ── Maestros genéricos (categories, paymentMethods, etc.) ───────
    // Aplica a cualquier colección de maestro que siga esta convención.
    // Si se prefiere una regla por colección, duplicar este bloque con
    // el nombre exacto en vez del wildcard.
    match /{masterCollection}/{docId} {
      allow read: if isSignedIn()
                  && masterCollection in ['categories', 'paymentMethods', 'movementTypes', 'accounts', 'budgetCategories'];

      allow create: if isSignedIn()
                    && masterCollection in ['categories', 'paymentMethods', 'movementTypes', 'accounts', 'budgetCategories']
                    && isOwnerField('createdBy')
                    && isOwnerField('updatedBy');

      allow update: if isSignedIn()
                    && masterCollection in ['categories', 'paymentMethods', 'movementTypes', 'accounts', 'budgetCategories']
                    && unchanged('createdAt')
                    && unchanged('createdBy')
                    && isOwnerField('updatedBy')
                    // updatedAt debe cambiar respecto al valor anterior
                    && request.resource.data.updatedAt != resource.data.updatedAt;

      // Eliminación física NUNCA se permite directo desde el cliente.
      // Ver ANALYSIS.md: la comprobación de referencias no puede
      // garantizarse de forma dura desde reglas. El borrado físico real
      // debe pasar por la Cloud Function callable `deleteMasterEntity`,
      // que usa Admin SDK y por lo tanto no está sujeta a estas reglas.
      allow delete: if false;
    }

    // ── Movimientos (ejemplo de colección que referencia maestros) ──
    match /movements/{movementId} {
      allow read, write: if isSignedIn() && isOwnerField('createdBy');
    }

    // ── Auditoría: solo lectura para usuarios, escritura solo desde
    // Cloud Functions (Admin SDK, que ignora estas reglas) ───────────
    match /auditLogs/{logId} {
      allow read: if isSignedIn();
      allow write: if false;
    }
  }
}
